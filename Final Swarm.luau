					.. "&hwid=" .. rrq(cand) .. "&game=" .. rrq(game.Name))
				if rytx and rytx.ok and type(rytx.packKey) == "string" and #rytx.packKey == 64 then
					db().LiquidHubPackKey = db().LiquidHubPackKey or {}
					db().LiquidHubPackKey["final-swarm"] = rytx.packKey
					return rytx.packKey
				end
			end
			token = nil
		end
		if not token then
			-- no live session: run the key system UI in-place and block until
			-- a key validates. Same fail-closed contract as the loader.
			local xban = "?cb=" .. tostring(os.time()) .. tostring(math.random(100000))
			local pr = rz("https://raw.githubusercontent.com/BO3DYXAN777/Liquid_Hub/refs/heads/main/KeySystemUI.luau" .. xban)
			if type(pr) ~= "string" or #pr < 1000 then
				pr = rz("https://raw.githubusercontent.com/BO3DYXAN777/Liquid_Hub/main/KeySystemUI.luau" .. xban)
			end
			if type(pr) == "string" and #pr >= 1000 then
				local mq, zbpn
				mq, zbpn = pcall(function()
					return (loadstring or load)(pr)()
				end)
				if mq and type(zbpn) == "table" and zbpn.Run then
					local gei = false
					zbpn.Run(function(s)
						token = s
						gei = true
					end)
					while not gei do task.wait(0.3) end
				end
			end
			if not token then return nil end
		end
		for _, cand in ipairs(cands) do
			local rytx = vxd(BACKEND .. "/api/pack/key?script=final-swarm&token=" .. rrq(token)
				.. "&hwid=" .. rrq(cand) .. "&game=" .. rrq(game.Name))
			if rytx and rytx.ok and type(rytx.packKey) == "string" and #rytx.packKey == 64 then
				db().LiquidHubPackKey = db().LiquidHubPackKey or {}
				db().LiquidHubPackKey["final-swarm"] = rytx.packKey
				return rytx.packKey
			end
		end
		return nil
	end
	local fppt, js = pcall(function()
		local kvj = yblf()
		if type(kvj) ~= "string" or #kvj ~= 64 then return nil end
		-- the pack key arrives as 64 hex chars; decode to 32 raw bytes FIRST
		-- (pack2.py XORs with the raw digest bytes, not the ASCII of the hex)
		local tnl = table.create(32)
		for dtm = 1, 32 do
			tnl[dtm] = tonumber(kvj:sub(dtm * 2 - 1, dtm * 2), 16) or 0
		end
		local ya = table.create(#cyn)
		for ld = 1, #cyn do
			local vt = tnl[(ld - 1) % 32 + 1]
			ya[ld] = string.char(bit32.bxor(cyn[ld], vt))
		end
		-- one-shot: scrub the key so a second decode can't reuse it
		pcall(function() db().LiquidHubPackKey["final-swarm"] = nil end)
		return table.concat(ya)
	end)
	if not fppt or type(js) ~= "string" or #js < 100 then
		warn("[Liquid Hub] Could not obtain pack key (no valid session / worker unreachable).")
		return
	end
	local rqtv, byhz = (loadstring or load)(js)
	if not rqtv then
		warn("[Liquid Hub] Packed script integrity failure.")
		return
	end
	return rqtv()
end)()
