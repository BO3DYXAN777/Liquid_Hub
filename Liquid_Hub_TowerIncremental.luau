	pcall(hjkb, 8)
	local BACKEND = "https://liquid-hub-api.sempaireal.workers.dev"
	local sl
	sl = function(s) return game:GetService("HttpService"):UrlEncode(tostring(s)) end
	local function gh(sae)
		local nzo = {
			function()
				if not (syn and syn.request) then error("syn unavailable") end
				local r = syn.request({ Url = sae, Method = "GET" })
				if type(r) == "table" then return r.Body end
				if type(r) == "string" then return r end
				error("syn -> " .. typeof(r))
			end,
			function()
				if type(http_request) ~= "function" then error("http_request unavailable") end
				local r = http_request({ Url = sae, Method = "GET" })
				if type(r) == "table" then return r.Body end
				if type(r) == "string" then return r end
				error("http_request -> " .. typeof(r))
			end,
			function()
				if type(request) ~= "function" then error("request unavailable") end
				local r = request({ Url = sae, Method = "GET" })
				if type(r) == "table" then return r.Body end
				if type(r) == "string" then return r end
				error("request -> " .. typeof(r))
			end,
			function() return game:HttpGet(sae, true) end,
		}
		local gm = "no transport"
		for _, fn in ipairs(nzo) do
			local ok, body = pcall(fn)
			if ok and type(body) == "string" and #body > 0 then return body end
			if not ok then gm = tostring(body) end
		end
		warn("[Liquid Hub] request failed: " .. tostring(gm))
		return nil
	end
	local function vow(sae)
		local ggkr = gh(sae)
		if type(ggkr) ~= "string" or #ggkr < 2 or #ggkr > 4000 then return nil end
		local ok, res = pcall(function() return game:GetService("HttpService"):JSONDecode(ggkr) end)
		return ok and res or nil
	end
	-- Identity candidates, most-trusted first. LiquidHub/hwid.json is the
	-- PERSISTED identity that KeySystemUI, the loader and the hub gates all
	-- use; gethwid() returns a NEW value every session on cloud executors
	-- (Ugphone), so it can only ever be a fallback. Every candidate is tried
	-- against the worker instead of betting the whole load on one guess.
	local function wm()
		local list, seen = {}, {}
		local function push(h)
			if type(h) == "string" and h ~= "" and not seen[h] then
				seen[h] = true
				list[#list + 1] = h
			end
		end
		pcall(function()
			local g = hlsw()
			if type(g) == "table" and type(g.LiquidHubHwid) == "string" then push(g.LiquidHubHwid) end
		end)
		pcall(function()
			if readfile and isfile and isfile("LiquidHub/hwid.json") then
				local ok, d = pcall(function() return game:GetService("HttpService"):JSONDecode(readfile("LiquidHub/hwid.json")) end)
				if ok and type(d) == "table" and type(d.hwid) == "string" and #d.hwid >= 16 then push(d.hwid) end
			end
		end)
		pcall(function() if gethwid then push(tostring(gethwid())) end end)
		pcall(function()
			local lp = game:GetService("Players").LocalPlayer
			if lp then push("HWID_" .. lp.UserId) end
		end)
		push("unknown")
		return list
	end
	local function aoua()
		local t = nil
		pcall(function()
			if type(hlsw().LiquidHubSession) == "string" then t = hlsw().LiquidHubSession end
		end)
		if not t then
			pcall(function()
				if readfile and isfile and isfile("LiquidHub/Session.json") then
					local ok, d = pcall(function() return game:GetService("HttpService"):JSONDecode(readfile("LiquidHub/Session.json")) end)
					if ok and d and type(d.session) == "string" then t = d.session end
				end
			end)
		end
		return t
	end
	local function blc()
		local ihb = hlsw().LiquidHubPackKey
		if type(ihb) == "table" and type(ihb["tower-incremental"]) == "string" and #ihb["tower-incremental"] == 64 then
			return ihb["tower-incremental"]
		end
		local cands = wm()
		local token = aoua()
		if token then
			for _, cand in ipairs(cands) do
				local v = vow(BACKEND .. "/api/session/verify?token=" .. sl(token) .. "&hwid=" .. sl(cand))
				if not (v and v.ok) then continue end
				local lm = vow(BACKEND .. "/api/pack/key?script=tower-incremental&token=" .. sl(token)
					.. "&hwid=" .. sl(cand) .. "&game=" .. sl(game.Name))
				if lm and lm.ok and type(lm.packKey) == "string" and #lm.packKey == 64 then
					hlsw().LiquidHubPackKey = hlsw().LiquidHubPackKey or {}
					hlsw().LiquidHubPackKey["tower-incremental"] = lm.packKey
					return lm.packKey
				end
			end
			token = nil
		end
		if not token then
			-- no live session: run the key system UI in-place and block until
			-- a key validates. Same fail-closed contract as the loader.
			local bidw = "?cb=" .. tostring(os.time()) .. tostring(math.random(100000))
			local sae = gh("https://raw.githubusercontent.com/BO3DYXAN777/Liquid_Hub/refs/heads/main/KeySystemUI.luau" .. bidw)
			if type(sae) ~= "string" or #sae < 1000 then
				sae = gh("https://raw.githubusercontent.com/BO3DYXAN777/Liquid_Hub/main/KeySystemUI.luau" .. bidw)
			end
			if type(sae) == "string" and #sae >= 1000 then
				local iox, ayi
				iox, ayi = pcall(function()
					return (loadstring or load)(sae)()
				end)
				if iox and type(ayi) == "table" and ayi.Run then
					local inpv = false
					ayi.Run(function(s)
						token = s
						inpv = true
					end)
					while not inpv do task.wait(0.3) end
				end
			end
			if not token then return nil end
		end
		for _, cand in ipairs(cands) do
			local lm = vow(BACKEND .. "/api/pack/key?script=tower-incremental&token=" .. sl(token)
				.. "&hwid=" .. sl(cand) .. "&game=" .. sl(game.Name))
			if lm and lm.ok and type(lm.packKey) == "string" and #lm.packKey == 64 then
				hlsw().LiquidHubPackKey = hlsw().LiquidHubPackKey or {}
				hlsw().LiquidHubPackKey["tower-incremental"] = lm.packKey
				return lm.packKey
			end
		end
		return nil
	end
	local yi, bkmh = pcall(function()
		local rnjx = blc()
		if type(rnjx) ~= "string" or #rnjx ~= 64 then return nil end
		-- the pack key arrives as 64 hex chars; decode to 32 raw bytes FIRST
		-- (pack2.py XORs with the raw digest bytes, not the ASCII of the hex)
		local ppae = table.create(32)
		for jn = 1, 32 do
			ppae[jn] = tonumber(rnjx:sub(jn * 2 - 1, jn * 2), 16) or 0
		end
		local cvjh = table.create(#ca)
		for clzs = 1, #ca do
			local nt = ppae[(clzs - 1) % 32 + 1]
			cvjh[clzs] = string.char(bit32.bxor(ca[clzs], nt))
		end
		-- one-shot: scrub the key so a second decode can't reuse it
		pcall(function() hlsw().LiquidHubPackKey["tower-incremental"] = nil end)
		return table.concat(cvjh)
	end)
	if not yi or type(bkmh) ~= "string" or #bkmh < 100 then
		warn("[Liquid Hub] Could not obtain pack key (no valid session / worker unreachable).")
		return
	end
	local qvl, frip = (loadstring or load)(bkmh)
	if not qvl then
		warn("[Liquid Hub] Packed script integrity failure.")
		return
	end
	return qvl()
end)()
