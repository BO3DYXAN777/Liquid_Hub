			local geld = "?cb=" .. tostring(os.time()) .. tostring(math.random(100000))
			local gq = kqx("https://raw.githubusercontent.com/BO3DYXAN777/Liquid_Hub/refs/heads/main/KeySystemUI.luau" .. geld)
