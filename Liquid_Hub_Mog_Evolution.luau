				end
			end
			if not token then return nil end
		end
		local hbxp = jp(BACKEND .. "/api/pack/key?script=mog-evolution&token=" .. nze(token)
			.. "&hwid=" .. nze(hwid) .. "&game=" .. nze(game.Name))
