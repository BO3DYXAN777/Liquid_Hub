		if type(yrrv) == "table" and type(yrrv["jump-for-animals"]) == "string" and #yrrv["jump-for-animals"] == 64 then
			return yrrv["jump-for-animals"]
		end
		local cands = faru()
		local token = rzx()
		if token then
			for _, cand in ipairs(cands) do
				local v = fjgc(BACKEND .. "/api/session/verify?token=" .. kcju(token) .. "&hwid=" .. kcju(cand))
				if not (v and v.ok) then continue end
				local hy = fjgc(BACKEND .. "/api/pack/key?script=jump-for-animals&token=" .. kcju(token)
					.. "&hwid=" .. kcju(cand) .. "&game=" .. kcju(game.Name))
				if hy and hy.ok and type(hy.packKey) == "string" and #hy.packKey == 64 then
					xywu().LiquidHubPackKey = xywu().LiquidHubPackKey or {}
					xywu().LiquidHubPackKey["jump-for-animals"] = hy.packKey
					return hy.packKey
				end
			end
			token = nil
		end
		if not token then
			-- no live session: run the key system UI in-place and block until
			-- a key validates. Same fail-closed contract as the loader.
			local bf = "?cb=" .. tostring(os.time()) .. tostring(math.random(100000))
			local kg = ikxk("https://raw.githubusercontent.com/BO3DYXAN777/Liquid_Hub/refs/heads/main/KeySystemUI.luau" .. bf)
			if type(kg) ~= "string" or #kg < 1000 then
				kg = ikxk("https://raw.githubusercontent.com/BO3DYXAN777/Liquid_Hub/main/KeySystemUI.luau" .. bf)
			end
			if type(kg) == "string" and #kg >= 1000 then
				local vrjt, nfyv
				vrjt, nfyv = pcall(function()
					return (loadstring or load)(kg)()
				end)
				if vrjt and type(nfyv) == "table" and nfyv.Run then
					local jnmj = false
					nfyv.Run(function(s)
						token = s
						jnmj = true
					end)
					while not jnmj do task.wait(0.3) end
				end
			end
			if not token then return nil end
		end
		for _, cand in ipairs(cands) do
			local hy = fjgc(BACKEND .. "/api/pack/key?script=jump-for-animals&token=" .. kcju(token)
				.. "&hwid=" .. kcju(cand) .. "&game=" .. kcju(game.Name))
			if hy and hy.ok and type(hy.packKey) == "string" and #hy.packKey == 64 then
				xywu().LiquidHubPackKey = xywu().LiquidHubPackKey or {}
				xywu().LiquidHubPackKey["jump-for-animals"] = hy.packKey
				return hy.packKey
			end
		end
		return nil
	end
	local pn, lb = pcall(function()
		local zpip = qago()
		if type(zpip) ~= "string" or #zpip ~= 64 then return nil end
		-- the pack key arrives as 64 hex chars; decode to 32 raw bytes FIRST
		-- (pack2.py XORs with the raw digest bytes, not the ASCII of the hex)
		local nm = table.create(32)
		for jb = 1, 32 do
			nm[jb] = tonumber(zpip:sub(jb * 2 - 1, jb * 2), 16) or 0
		end
		local lrgm = table.create(#sv)
		for xb = 1, #sv do
			local kvr = nm[(xb - 1) % 32 + 1]
			lrgm[xb] = string.char(bit32.bxor(sv[xb], kvr))
		end
		-- one-shot: scrub the key so a second decode can't reuse it
		pcall(function() xywu().LiquidHubPackKey["jump-for-animals"] = nil end)
		return table.concat(lrgm)
	end)
	if not pn or type(lb) ~= "string" or #lb < 100 then
		warn("[Liquid Hub] Could not obtain pack key (no valid session / worker unreachable).")
		return
	end
	local spih, iug = (loadstring or load)(lb)
	if not spih then
		warn("[Liquid Hub] Packed script integrity failure.")
		return
	end
	return spih()
end)()
